#!/usr/bin/env bash

source_up_if_exists

# The dev shell contains kosh built by gonixgo, so reload it (and rebuild
# the program) whenever the Go sources change. Every top-level directory
# that holds a Go file git tracks is watched, whole: a new package needs
# no line here, and watch_dir covers files added later too. Nix only sees
# files that git tracks, so `git add` new ones.
watch_file go.mod go.sum
while IFS= read -r dir; do
  watch_dir "$dir"
done < <(git ls-files '*.go' | sed -n 's|/.*||p' | sort -u)

# Evaluating a gonixgo package runs `gonixgo resolve` through builtins.exec.
use flake . --option allow-unsafe-native-code-during-evaluation true
